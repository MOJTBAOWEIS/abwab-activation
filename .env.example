# Copy to .env on the host, or set these as the platform's environment vars.

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out; losing it is harmless, just set a new one.
ABWAB_SECRET_KEY=replace-me-with-a-long-random-value

# Turns on HTTPS-only cookies and proxy awareness.
ABWAB_ENV=production

# Point this at a PERSISTENT disk. On most hosts the normal filesystem is
# wiped on every deploy — leaving this unset there loses every lead.
ABWAB_DB=/data/abwab.db
